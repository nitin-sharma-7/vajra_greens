next-env.d.ts

# ── Environment variables ─────────────────────
.env
.env*.local
.env.*
!.env.example

# ── Deployment ────────────────────────────────
.vercel/
.netlify/

# ── Testing / QA ──────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
.qa/
.chrome-test*/

# ── Logs & debug ──────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ── Caches ────────────────────────────────────
.cache/
.eslintcache
.turbo/
*.pem

# ── Editors & OS ──────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

